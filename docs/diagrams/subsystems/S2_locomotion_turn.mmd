flowchart TD
  classDef start fill:#1f3a5f,color:#fff,stroke:#0b1d33
  classDef ok fill:#e6f7e9,stroke:#2a8a3e
  classDef bad fill:#fde8e8,stroke:#b33
  classDef act fill:#e8f0fb,stroke:#1f3a5f
  A([CMD_START: turn to the next row<br/>direction from the route map:<br/>right twice, then left twice, alternating]):::start
  R[Drive on to the turn point<br/>run-out, if the route map has one]:::act
  B{Turned 90?<br/>encoder}
  C[Turn]:::act
  D[Drive forward]:::act
  E{Crossed the planned<br/>number of crests?<br/>front sensor}
  F{Distance or<br/>time limit used up?}
  G{Encoder agrees with<br/>the planned row gap?}
  H{Turned 90 again?<br/>encoder}
  I[Turn]:::act
  J([DONE: facing the other way<br/>on the next crest]):::ok
  X([FAULT: TURN_FAILED]):::bad
  A --> R --> B
  B -- NO --> C --> B
  B -- YES --> D --> E
  E -- NO --> F
  F -- NO, keep driving --> E
  F -- YES, wheels stop --> X
  E -- YES --> G
  G -- NO, keep driving --> F
  G -- YES --> H
  H -- NO --> I --> H
  H -- YES --> J
