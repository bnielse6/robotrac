flowchart TD
  classDef start fill:#1f3a5f,color:#fff,stroke:#0b1d33
  classDef ok fill:#e6f7e9,stroke:#2a8a3e
  classDef bad fill:#fde8e8,stroke:#b33
  classDef act fill:#e8f0fb,stroke:#1f3a5f
  A([CMD_START: load a screw]):::start
  B{Screws available?}
  X0([NEED_REFILL: screws]):::bad
  C[Load the screw into<br/>fastening position]:::act
  D{Live camera sees the plate and<br/>screw together, both in the right spot?}
  X1([FAULT: SCREW_NOT_IN_POSITION<br/>missing or not lined up]):::bad
  E([DONE: ready to fasten]):::ok
  A --> B
  B -- NO --> X0
  B -- YES --> C --> D
  D -- NO --> X1
  D -- YES --> E
