flowchart TD
  classDef start fill:#1f3a5f,color:#fff,stroke:#0b1d33
  classDef ok fill:#e6f7e9,stroke:#2a8a3e
  classDef bad fill:#fde8e8,stroke:#b33
  classDef act fill:#e8f0fb,stroke:#1f3a5f
  A([CMD_START: drive to the next spot<br/>distance from the route map]):::start
  B{On the crest?<br/>crest sensors}
  C{Time limit<br/>used up?}
  D[Relocate to the crest]:::act
  E{At the right spot?<br/>encoder + route map}
  F{Time limit<br/>used up?}
  G[Keep moving to the spot]:::act
  P{Past the spot by<br/>more than the limit?<br/>encoder}
  H([DONE: stop at the spot<br/>reports the sideways error]):::ok
  AL{Sideways error within<br/>the limit?<br/>average of several readings}
  LA{Tried too many<br/>times?}
  NU[Nudge sideways<br/>by the error]:::act
  X1([FAULT: OFF_CREST]):::bad
  X2([FAULT: CANNOT_REACH_SPOT]):::bad
  X3([FAULT: OVERSHOT_SPOT<br/>no retry]):::bad
  X4([FAULT: NOT_ALIGNED]):::bad
  A --> B
  B -- NO --> C
  C -- NO --> D --> B
  C -- YES, wheels stop --> X1
  B -- YES --> E
  E -- NO --> F
  F -- NO --> G --> B
  F -- YES, wheels stop --> X2
  E -- YES, wheels stop --> P
  P -- NO --> AL
  AL -- YES --> H
  AL -- NO --> LA
  LA -- NO --> NU --> AL
  LA -- YES, wheels stop --> X4
  P -- YES --> X3
